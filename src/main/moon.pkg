import {
  "f-a24/gh-lg-search/src/domain",
  "f-a24/gh-lg-search/src/ffi",
  "f-a24/gh-lg-search/src/layout",
  "f-a24/gh-lg-search/src/orbit",
  "f-a24/gh-lg-search/src/render",
  "moonbit-community/rabbita",
  "moonbit-community/rabbita/cmd",
  "moonbit-community/rabbita/html",
  "moonbitlang/core/cmp",
  "moonbitlang/core/json",
}

supported_targets = "js"

pkgtype(kind: "executable")

rule(
  name: "embed-fixture",
  command: ":embed -i $input -o $output --name f_a24_repos_json --text",
)

dev_build(
  rule: "embed-fixture",
  input: "../../fixtures/f-a24-repos.json",
  output: "fixture_data.mbt",
)
